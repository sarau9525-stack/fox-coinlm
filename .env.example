# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token obtained from @BotFather in Telegram.
# Used on the server to validate Telegram Mini App initData HMAC signatures.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# TELEGRAM_BOT_USERNAME: The username of your Telegram Bot (without @).
# Used to generate deep links for referrals and Mini App launch buttons.
TELEGRAM_BOT_USERNAME="FOX_COINlBOT"

# SESSION_SECRET: Secret key for signing server authentication tokens.
SESSION_SECRET="fox_coin_production_secret_key"

# ADMIN_SECRET: Secret key for authenticating administrators to configure Telegram Webhooks.
ADMIN_SECRET="123456"

# ADMIN_EMAIL: Email of designated administrator account.
ADMIN_EMAIL="k39127031@gmail.com"

# TELEGRAM_WEBHOOK_SECRET: Secret token passed to Telegram setWebhook for X-Telegram-Bot-Api-Secret-Token validation.
TELEGRAM_WEBHOOK_SECRET="fox_coin_webhook_secret_key"
